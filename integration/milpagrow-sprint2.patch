index 57245ec..69736be 100644
--- a/server/index.js
+++ b/server/index.js
@@ -35,6 +35,10 @@ const host = "0.0.0.0";
 
 // Permite que la app de Flutter se conecte sin bloqueos de seguridad
 app.disable('x-powered-by');
+// En Render, configura 1 sólo si la API está detrás de su proxy y no es accesible
+// directamente. Express calcula req.ip sin confiar en encabezados arbitrarios.
+const proxyHops = Number(process.env.TRUST_PROXY_HOPS || 0);
