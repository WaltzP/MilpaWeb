diff --git a/server/modules/website/apk.js b/server/modules/website/apk.js
new file mode 100644
index 0000000..f9370ce
--- /dev/null
+++ b/server/modules/website/apk.js
@@ -0,0 +1,45 @@
+const yauzl = require('yauzl');
+const { ApiError } = require('../shared/http');
+// No extrae archivos. Lee sólo el encabezado del manifiesto y un DEX, con límites.
+function validateApk(file) {
+  return new Promise((resolve, reject) => {
+    yauzl.open(file, { lazyEntries: true, validateEntrySizes: true }, (error, zip) => {
+      if (error) return reject(new ApiError(400, 'INVALID_APK', 'El archivo no es un APK válido.'));
+      let count = 0, total = 0, manifest = false, dex = false, ended = false;
+      function fail() {
+        if (ended) return;
+        ended = true; zip.close();
+        reject(new ApiError(400, 'INVALID_APK', 'El archivo debe ser un APK Android con manifiesto y código válidos.'));
+      }
+      zip.on('error', fail);
+      zip.on('entry', entry => {
+        total += entry.uncompressedSize;
+        if (++count > 20000 || total > 1024 * 1024 * 1024 || entry.isEncrypted() || entry.fileName.includes('..') || entry.fileName.startsWith('/')) return fail();
+        const isManifest = entry.fileName === 'AndroidManifest.xml';
+        const isDex = entry.fileName === 'classes.dex';
+        if (!isManifest && !isDex) return zip.readEntry();
+        if (isManifest && (manifest || entry.uncompressedSize > 2 * 1024 * 1024)) return fail();
+        if (isDex && dex) return fail();
+        zip.openReadStream(entry, (error, stream) => {
+          if (error) return fail();
+          let prefix = Buffer.alloc(0);
+          stream.on('error', fail);
+          stream.on('data', chunk => { if (prefix.length < 8) prefix = Buffer.concat([prefix, chunk.subarray(0, 8 - prefix.length)]); });
+          stream.on('end', () => {
+            if (ended) return;
+            if (isManifest) manifest = prefix.length === 8 && prefix.readUInt32LE(0) === 0x00080003;
+            if (isDex) dex = /^dex\n\d{3}\x00$/.test(prefix.toString('latin1'));
+            if (!(isManifest ? manifest : dex)) return fail();
+            zip.readEntry();
+          });
+        });
+      });
+      zip.on('end', () => {
+        if (!manifest || !dex) return fail();
+        if (!ended) { ended = true; resolve(); }
+      });
+      zip.readEntry();
+    });
+  });
+}
+module.exports = { validateApk };
diff --git a/server/modules/website/demos.js b/server/modules/website/demos.js
new file mode 100644
index 0000000..a45f858
--- /dev/null
+++ b/server/modules/website/demos.js
@@ -0,0 +1,88 @@
+const crypto = require('node:crypto');
+const { FieldPath } = require('firebase-admin/firestore');
+const { ApiError } = require('../shared/http');
+const validation = require('./validation');
+const WINDOW = 15 * 60 * 1000;
+function createDemos(db, { secret = process.env.WEBSITE_SPAM_SECRET, now = Date.now } = {}) {
+  function sign(value) {
+    if (!db || !secret || secret.length < 32) throw new ApiError(503, 'WEBSITE_CONFIG', 'El servicio de demostraciones todavía no está disponible.');
+    return crypto.createHmac('sha256', secret).update(value).digest('hex');
+  }
+  function challenge() {
+    const payload = `${now()}.${crypto.randomBytes(16).toString('hex')}`;
+    return { challenge: `${payload}.${sign(payload)}`, minWaitMs: 2000 };
+  }
+  function verify(value) {
+    if (typeof value !== 'string' || !/^\d{13}\.[a-f0-9]{32}\.[a-f0-9]{64}$/.test(value)) validation.invalid('Actualiza el formulario e inténtalo de nuevo.');
+    const parts = value.split('.');
+    if (!crypto.timingSafeEqual(Buffer.from(parts[2], 'hex'), Buffer.from(sign(`${parts[0]}.${parts[1]}`), 'hex'))) validation.invalid('Actualiza el formulario e inténtalo de nuevo.');
+    const age = now() - Number(parts[0]);
+    if (age < 2000 || age > 3600000) throw new ApiError(400, 'CHALLENGE_EXPIRED', 'Actualiza el formulario e inténtalo de nuevo.');
+  }
+  async function submit(body, key, ip) {
+    const data = validation.demo(body);
+    if (typeof body.website !== 'string' || body.website !== '') throw new ApiError(400, 'SPAM_REJECTED', 'No fue posible enviar la solicitud.');
+    verify(body.challenge);
+    if (typeof key !== 'string' || !/^[a-f0-9-]{36}$/.test(key)) validation.invalid('Falta el identificador del envío.');
+    const fingerprint = sign(JSON.stringify(data));
+    const ref = db.collection('websiteDemoRequests').doc(sign(`request:${key}`));
+    const duplicate = db.collection('websiteDemoDedup').doc(fingerprint);
+    const bucket = Math.floor(now() / WINDOW);
+    const limits = [
+      { ref: db.collection('websiteDemoLimits').doc(sign(`ip:${ip}:${bucket}`)), max: 10 },
+      { ref: db.collection('websiteDemoLimits').doc(sign(`email:${data.email}:${bucket}`)), max: 3 },
+    ];
+    await db.runTransaction(async tx => {
+      const [existing, similar, ...counters] = await Promise.all([tx.get(ref), tx.get(duplicate), ...limits.map(item => tx.get(item.ref))]);
+      if (existing.exists) {
+        if (existing.data().fingerprint !== fingerprint) throw new ApiError(409, 'IDEMPOTENCY_CONFLICT', 'Los datos del envío cambiaron. Inténtalo de nuevo.');
+        return;
+      }
+      if (similar.exists && similar.data().expiresAt.toMillis() > now()) return;
+      if (counters.some((record, index) => (record.data()?.count || 0) >= limits[index].max)) throw new ApiError(429, 'DEMO_RATE_LIMIT', 'Has enviado varias solicitudes. Espera 15 minutos antes de intentar de nuevo.');
+      const timestamp = now();
+      limits.forEach((item, index) => tx.set(item.ref, { count: (counters[index].data()?.count || 0) + 1, expiresAt: new Date((bucket + 2) * WINDOW) }));
+      tx.set(duplicate, { expiresAt: new Date(timestamp + 86400000) });
+      tx.create(ref, { ...data, status: 'pendiente', notes: '', revision: 0, fingerprint, createdAt: timestamp, updatedAt: timestamp });
+    });
+    // No devuelve datos ni identificadores de solicitudes a visitantes.
+    return { accepted: true };
+  }
+  function visible(record) { const { fingerprint, ...data } = record.data(); return { id: record.id, ...data }; }
+  async function list(status, cursor) {
+    if (status && !validation.STATES.includes(status)) validation.invalid('El estado no es válido.');
+    let query = db.collection('websiteDemoRequests');
+    if (status) query = query.where('status', '==', status);
+    query = query.orderBy('createdAt', 'desc').orderBy(FieldPath.documentId(), 'desc');
+    if (cursor) {
+      validation.identifier(cursor);
+      const record = await db.collection('websiteDemoRequests').doc(cursor).get();
+      if (!record.exists) validation.invalid('La página solicitada ya no está disponible.');
+      query = query.startAfter(record.data().createdAt, record.id);
+    }
+    const result = await query.limit(26).get();
+    const records = result.docs.slice(0, 25);
+    return { items: records.map(visible), nextCursor: result.docs.length > 25 ? records.at(-1).id : null };
+  }
+  async function detail(id) {
+    const record = await db.collection('websiteDemoRequests').doc(validation.identifier(id)).get();
+    if (!record.exists) throw new ApiError(404, 'DEMO_NOT_FOUND', 'No se encontró la solicitud.');
+    return visible(record);
+  }
+  async function update(id, body, uid) {
+    validation.object(body, ['status', 'notes', 'revision']);
+    if (!validation.STATES.includes(body.status)) validation.invalid('El estado no es válido.');
+    const notes = validation.text(body.notes, 'Notas', 0, 5000);
+    if (!Number.isSafeInteger(body.revision) || body.revision < 0) validation.invalid('La revisión no es válida.');
+    const ref = db.collection('websiteDemoRequests').doc(validation.identifier(id));
+    await db.runTransaction(async tx => {
+      const record = await tx.get(ref);
+      if (!record.exists) throw new ApiError(404, 'DEMO_NOT_FOUND', 'No se encontró la solicitud.');
+      if (record.data().revision !== body.revision) throw new ApiError(409, 'DEMO_CHANGED', 'Otro administrador actualizó esta solicitud. Vuelve a abrirla antes de guardar.');
+      tx.update(ref, { status: body.status, notes, revision: body.revision + 1, updatedAt: now(), updatedBy: uid });
+    });
+    return detail(id);
+  }
+  return { challenge, submit, list, detail, update };
+}
+module.exports = { createDemos };
diff --git a/server/modules/website/github.js b/server/modules/website/github.js
new file mode 100644
index 0000000..abb5522
--- /dev/null
+++ b/server/modules/website/github.js
@@ -0,0 +1,62 @@
+const { createReadStream } = require('node:fs');
+const { ApiError } = require('../shared/http');
+function createGithub({ token = process.env.GITHUB_RELEASE_TOKEN, owner = process.env.GITHUB_RELEASE_OWNER || 'WaltzP', repo = process.env.GITHUB_RELEASE_REPO || 'MilpaWeb', fetchImpl = fetch } = {}) {
+  const base = `https://api.github.com/repos/${owner}/${repo}`;
+  const headers = { Authorization: `Bearer ${token}`, Accept: 'application/vnd.github+json', 'X-GitHub-Api-Version': '2026-03-10', 'User-Agent': 'MilpaGrow-Website' };
+  async function request(url, options = {}) {
+    if (!token || !/^[A-Za-z0-9_.-]+$/.test(owner) || !/^[A-Za-z0-9_.-]+$/.test(repo)) throw new ApiError(503, 'GITHUB_CONFIG', 'Configura la distribución de instaladores en el servidor.');
+    let response;
+    try { response = await fetchImpl(url, { ...options, headers: { ...headers, ...options.headers }, redirect: 'error', signal: AbortSignal.timeout(options.body && typeof options.body !== 'string' ? 600000 : 30000) }); }
+    catch { throw new ApiError(502, 'GITHUB_NETWORK', 'No se pudo completar la operación con GitHub. Puedes volver a intentar.'); }
+    if (!response.ok) throw new ApiError(502, 'GITHUB_ERROR', `GitHub no completó la operación (${response.status}). Revisa los permisos y vuelve a intentar.`);
+    return response.json();
+  }
+  async function draft(record) {
+    if (record.githubReleaseId) return request(`${base}/releases/${record.githubReleaseId}`);
+    // Recupera borradores que quedaron creados antes de una interrupción de la API.
+    for (let page = 1; page <= 10; page++) {
+      const releases = await request(`${base}/releases?per_page=100&page=${page}`);
+      const found = releases.find(item => item.tag_name === record.tag);
+      if (found) {
+        if (!found.draft) throw new ApiError(409, 'RELEASE_TAG_EXISTS', 'Ya existe una versión publicada con este código. Usa uno nuevo.');
+        return found;
+      }
+      if (releases.length < 100) break;
+    }
+    return request(`${base}/releases`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ tag_name: record.tag, name: `MilpaGrow ${record.version}`, body: record.notes, draft: true, prerelease: false }) });
+  }
+  function downloadUrl(url) {
+    const expected = `https://github.com/${owner}/${repo}/releases/download/`;
+    if (typeof url !== 'string' || !url.startsWith(expected) || /\s/.test(url)) throw new ApiError(502, 'GITHUB_ASSET', 'GitHub devolvió un enlace de descarga inválido.');
+    return url;
+  }
+  async function upload(release, file, size, sha256) {
+    if (!release.draft) throw new ApiError(409, 'RELEASE_PUBLISHED', 'Esta versión ya está publicada.');
+    const name = 'MilpaGrow.apk';
+    for (const asset of release.assets || []) if (asset.name === name) {
+      // Reutiliza el archivo completo cuando una respuesta anterior se perdió.
+      if (asset.state === 'uploaded' && asset.size === size && asset.digest === `sha256:${sha256}`) return { ...asset, browser_download_url: downloadUrl(asset.browser_download_url) };
+      const response = await fetchImpl(`${base}/releases/assets/${asset.id}`, { method: 'DELETE', headers, signal: AbortSignal.timeout(30000), redirect: 'error' }).catch(() => null);
+      if (!response?.ok) throw new ApiError(502, 'GITHUB_ERROR', 'No se pudo preparar el reintento de carga en GitHub.');
+    }
+    const asset = await request(`https://uploads.github.com/repos/${owner}/${repo}/releases/${release.id}/assets?name=${name}`, {
+      method: 'POST', headers: { 'Content-Type': 'application/vnd.android.package-archive', 'Content-Length': String(size) }, body: createReadStream(file), duplex: 'half',
+    });
+    if (asset.state !== 'uploaded' || asset.size !== size || (asset.digest && asset.digest !== `sha256:${sha256}`)) throw new ApiError(502, 'GITHUB_ASSET', 'GitHub no confirmó la carga completa del APK.');
+    return { ...asset, browser_download_url: downloadUrl(asset.browser_download_url) };
+  }
+  async function publish(record) {
+    const repository = await request(base);
+    if (repository.private !== false) throw new ApiError(409, 'PRIVATE_RELEASE_REPO', 'El repositorio de instaladores debe ser público.');
+    const asset = await request(`${base}/releases/assets/${record.githubAssetId}`);
+    if (asset.state !== 'uploaded' || asset.size !== record.sizeBytes || (asset.digest && asset.digest !== `sha256:${record.sha256}`)) throw new ApiError(409, 'ASSET_INCOMPLETE', 'El APK no está disponible o cambió en GitHub. Vuelve a cargarlo.');
+    downloadUrl(asset.browser_download_url);
+    let release = await request(`${base}/releases/${record.githubReleaseId}`);
+    if (!(release.assets || []).some(item => item.id === record.githubAssetId)) throw new ApiError(409, 'ASSET_MISMATCH', 'El APK no pertenece a esta versión.');
+    if (release.draft) release = await request(`${base}/releases/${record.githubReleaseId}`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ draft: false, prerelease: false, make_latest: 'false' }) });
+    if (release.draft || release.prerelease || !release.published_at) throw new ApiError(502, 'GITHUB_PUBLISH', 'GitHub no confirmó la publicación.');
+    return { publishedAt: release.published_at, downloadUrl: asset.browser_download_url };
+  }
+  return { draft, upload, publish };
+}
+module.exports = { createGithub };
diff --git a/server/modules/website/releases.js b/server/modules/website/releases.js
new file mode 100644
index 0000000..c5742c6
--- /dev/null
+++ b/server/modules/website/releases.js
@@ -0,0 +1,111 @@
+const { mkdtemp, rm } = require('node:fs/promises');
+const { createWriteStream } = require('node:fs');
+const { tmpdir } = require('node:os');
+const path = require('node:path');
+const { Transform } = require('node:stream');
+const { pipeline } = require('node:stream/promises');
+const { createHash } = require('node:crypto');
+const { FieldPath } = require('firebase-admin/firestore');
+const { ApiError } = require('../shared/http');
+const validation = require('./validation');
+const { validateApk } = require('./apk');
+const { createGithub } = require('./github');
+const MAX_BYTES = 250 * 1024 * 1024;
+const LEASE_MS = 20 * 60 * 1000;
+function createReleases(db, { github = createGithub(), now = Date.now, maxBytes = MAX_BYTES } = {}) {
+  const collection = () => db.collection('websiteReleases');
+  const current = () => db.collection('websiteSettings').doc('publicRelease');
+  function manifest(record) {
+    return { id: record.id, version: record.version, versionCode: record.versionCode, notes: record.notes, minAndroid: record.minAndroid, sizeBytes: record.sizeBytes, sha256: record.sha256, downloadUrl: record.downloadUrl, publishedAt: record.publishedAt };
+  }
+  async function publicVersion() { return (await current().get()).data()?.release || null; }
+  async function create(body, uid) {
+    const data = validation.release(body);
+    const id = `android-${data.versionCode}`;
+    const ref = collection().doc(id);
+    await db.runTransaction(async tx => {
+      if ((await tx.get(ref)).exists) throw new ApiError(409, 'VERSION_EXISTS', 'Este código de versión ya está registrado. Reintenta su carga desde el historial o usa otro código.');
+      tx.create(ref, { ...data, status: 'draft', tag: `milpagrow-android-${data.versionCode}`, createdAt: now(), createdBy: uid, updatedAt: now() });
+    });
+    return detail(id);
+  }
+  async function detail(id) {
+    const record = await collection().doc(validation.identifier(id)).get();
+    if (!record.exists) throw new ApiError(404, 'RELEASE_NOT_FOUND', 'No se encontró esta versión.');
+    return { id: record.id, ...record.data() };
+  }
+  async function list(cursor) {
+    let query = collection().orderBy('createdAt', 'desc').orderBy(FieldPath.documentId(), 'desc');
+    if (cursor) {
+      const record = await detail(cursor);
+      query = query.startAfter(record.createdAt, record.id);
+    }
+    const [result, settings] = await Promise.all([query.limit(26).get(), current().get()]);
+    const records = result.docs.slice(0, 25);
+    return { items: records.map(record => ({ id: record.id, ...record.data() })), nextCursor: result.docs.length > 25 ? records.at(-1).id : null, currentReleaseId: settings.data()?.release?.id || null, maxBytes };
+  }
+  async function claim(id, operation, allowed) {
+    const ref = collection().doc(validation.identifier(id));
+    let record;
+    await db.runTransaction(async tx => {
+      const snapshot = await tx.get(ref);
+      if (!snapshot.exists) throw new ApiError(404, 'RELEASE_NOT_FOUND', 'No se encontró esta versión.');
+      record = { id, ...snapshot.data() };
+      if (record.leaseUntil > now()) throw new ApiError(409, 'RELEASE_BUSY', 'Esta versión tiene una operación en curso. Espera antes de volver a intentar.');
+      const previous = ['uploading', 'publishing'].includes(record.status) ? record.previousStatus : record.status;
+      if (!allowed.includes(previous)) throw new ApiError(409, 'RELEASE_STATE', 'Completa la carga del APK antes de publicar esta versión.');
+      tx.update(ref, { status: operation, previousStatus: previous, leaseUntil: now() + LEASE_MS, updatedAt: now(), error: '' });
+      record.previousStatus = previous;
+    });
+    return record;
+  }
+  async function upload(id, request, uid) {
+    const type = (request.headers['content-type'] || '').split(';')[0];
+    if (!['application/octet-stream', 'application/vnd.android.package-archive'].includes(type)) throw new ApiError(415, 'APK_CONTENT_TYPE', 'Selecciona un archivo APK para cargar.');
+    const announced = Number(request.headers['content-length']);
+    if (announced > maxBytes) throw new ApiError(413, 'APK_TOO_LARGE', 'El APK supera el tamaño máximo de carga.');
+    const record = await claim(id, 'uploading', ['draft', 'failed']);
+    let directory;
+    try {
+      directory = await mkdtemp(path.join(tmpdir(), 'milpagrow-apk-'));
+      const file = path.join(directory, 'MilpaGrow.apk');
+      let size = 0;
+      const hash = createHash('sha256');
+      request.setTimeout?.(600000);
+      const guard = new Transform({ transform(chunk, encoding, callback) {
+        size += chunk.length;
+        if (size > maxBytes) return callback(new ApiError(413, 'APK_TOO_LARGE', 'El APK supera el tamaño máximo de carga.'));
+        hash.update(chunk); callback(null, chunk);
+      } });
+      await pipeline(request, guard, createWriteStream(file, { flags: 'wx', mode: 0o600 }));
+      if (!size || (Number.isFinite(announced) && request.headers['content-length'] && announced !== size)) throw new ApiError(400, 'APK_INCOMPLETE', 'El archivo llegó incompleto. Vuelve a cargarlo.');
+      await validateApk(file);
+      const sha256 = hash.digest('hex');
+      const release = await github.draft(record);
+      await collection().doc(id).update({ githubReleaseId: release.id });
+      const asset = await github.upload(release, file, size, sha256);
+      await collection().doc(id).update({ status: 'uploaded', leaseUntil: 0, sizeBytes: size, sha256, githubAssetId: asset.id, downloadUrl: asset.browser_download_url, uploadedBy: uid, updatedAt: now(), error: '' });
+      return detail(id);
+    } catch (error) {
+      await collection().doc(id).update({ status: 'failed', leaseUntil: 0, updatedAt: now(), error: error instanceof ApiError ? error.message : 'La carga fue interrumpida. Vuelve a intentar.' });
+      throw error;
+    } finally { if (directory) await rm(directory, { recursive: true, force: true }); }
+  }
+  async function publish(id, uid) {
+    const record = await claim(id, 'publishing', ['uploaded', 'published']);
+    try {
+      const result = await github.publish(record);
+      const published = { ...record, ...result, status: 'published' };
+      await db.runTransaction(async tx => {
+        tx.update(collection().doc(id), { ...result, status: 'published', leaseUntil: 0, publishedBy: uid, updatedAt: now(), error: '' });
+        tx.set(current(), { release: manifest(published), selectedAt: now(), selectedBy: uid });
+      });
+      return manifest(published);
+    } catch (error) {
+      await collection().doc(id).update({ status: record.previousStatus, leaseUntil: 0, updatedAt: now(), error: error instanceof ApiError ? error.message : 'No se pudo completar la publicación. Puedes reintentar.' });
+      throw error;
+    }
+  }
+  return { publicVersion, create, detail, list, upload, publish };
+}
+module.exports = { createReleases, MAX_BYTES };
diff --git a/server/modules/website/validation.js b/server/modules/website/validation.js
new file mode 100644
index 0000000..fdc81ab
--- /dev/null
+++ b/server/modules/website/validation.js
@@ -0,0 +1,37 @@
+const { ApiError } = require('../shared/http');
+const STATES = ['pendiente', 'contactada', 'agendada', 'realizada', 'cerrada'];
+const ACTIVITIES = ['agricola', 'porcina', 'mixta', 'otra'];
+function invalid(message) { throw new ApiError(400, 'VALIDATION_ERROR', message); }
+function object(value, keys) {
+  if (!value || typeof value !== 'object' || Array.isArray(value) || Object.keys(value).some(key => !keys.includes(key))) invalid('Los campos enviados no son válidos.');
+}
+function text(value, name, min, max) {
+  if (typeof value !== 'string') invalid(`${name}: introduce texto válido.`);
+  const normalized = value.trim();
+  if (normalized.length < min || normalized.length > max || /[\u0000-\u0008\u000b\u000c\u000e-\u001f]/.test(normalized)) invalid(`${name}: usa entre ${min} y ${max} caracteres.`);
+  return normalized;
+}
+function demo(value) {
+  object(value, ['name', 'email', 'phone', 'activity', 'message', 'website', 'challenge']);
+  const name = text(value.name, 'Nombre', 2, 100);
+  const email = text(value.email, 'Correo', 3, 254).toLowerCase();
+  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) invalid('Introduce un correo válido.');
+  const phone = text(value.phone ?? '', 'Teléfono', 0, 30);
+  if (phone && !/^\+?[\d\s().-]{7,30}$/.test(phone)) invalid('Introduce un teléfono válido.');
+  if (!ACTIVITIES.includes(value.activity)) invalid('Selecciona una actividad de interés.');
+  return { name, email, phone, activity: value.activity, message: text(value.message, 'Mensaje', 10, 2000) };
+}
+function release(value) {
+  object(value, ['version', 'versionCode', 'notes', 'minAndroid']);
+  const version = text(value.version, 'Versión', 3, 50);
+  if (!/^\d+\.\d+\.\d+(?:[-+][A-Za-z0-9.-]+)?$/.test(version)) invalid('Usa una versión como 1.2.0.');
+  if (!Number.isSafeInteger(value.versionCode) || value.versionCode < 1 || value.versionCode > 2100000000) invalid('El código de versión debe ser un entero positivo.');
+  const minAndroid = text(value.minAndroid, 'Android mínimo', 1, 20);
+  if (!/^\d+(?:\.\d+){0,2}$/.test(minAndroid)) invalid('Usa un requisito como 7.0.');
+  return { version, versionCode: value.versionCode, notes: text(value.notes, 'Novedades', 10, 5000), minAndroid };
+}
+function identifier(value) {
+  if (typeof value !== 'string' || !/^[A-Za-z0-9_-]{1,100}$/.test(value)) invalid('El identificador no es válido.');
+  return value;
+}
+module.exports = { STATES, ACTIVITIES, invalid, object, text, demo, release, identifier };
