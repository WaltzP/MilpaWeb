+const express = require('express');
+const db = require('../../firebaseAdmin');
+const { ApiError, asyncHandler, ok } = require('../shared/http');
+const { createAuthRateLimit } = require('../../middleware/authRateLimit');
+const { adminMiddleware } = require('./admin');
+const { createDemos } = require('./demos');
+const { createReleases } = require('./releases');
+function createWebsiteRouter({ database = db, demos = createDemos(database), releases = createReleases(database), admin = adminMiddleware } = {}) {
+  const router = express.Router();
+  router.use((req, res, next) => {
+    res.set('Cache-Control', 'no-store');
+    if (!database) return next(new ApiError(503, 'WEBSITE_CONFIG', 'El servicio todavía no está disponible.'));
+    next();
+  });
+  router.get('/release', asyncHandler(async (req, res) => ok(res, await releases.publicVersion())));
+  router.get('/demo-challenge', asyncHandler(async (req, res) => ok(res, demos.challenge())));
+  router.post('/demo-requests', createAuthRateLimit({ limit: 60 }), express.json({ limit: '16kb' }), asyncHandler(async (req, res) => ok(res, await demos.submit(req.body, req.get('Idempotency-Key'), req.ip), 202)));
+  router.use('/admin', ...admin);
+  router.get('/admin/session', (req, res) => ok(res, { uid: req.user.uid, email: req.user.email }));
+  router.get('/admin/demo-requests', asyncHandler(async (req, res) => ok(res, await demos.list(req.query.status, req.query.cursor))));
+  router.get('/admin/demo-requests/:id', asyncHandler(async (req, res) => ok(res, await demos.detail(req.params.id))));
+  router.patch('/admin/demo-requests/:id', express.json({ limit: '16kb' }), asyncHandler(async (req, res) => ok(res, await demos.update(req.params.id, req.body, req.user.uid))));
+  router.get('/admin/releases', asyncHandler(async (req, res) => ok(res, await releases.list(req.query.cursor))));
+  router.post('/admin/releases', express.json({ limit: '16kb' }), asyncHandler(async (req, res) => ok(res, await releases.create(req.body, req.user.uid), 201)));
+  router.put('/admin/releases/:id/apk', asyncHandler(async (req, res) => ok(res, await releases.upload(req.params.id, req, req.user.uid))));
+  router.post('/admin/releases/:id/publish', asyncHandler(async (req, res) => ok(res, await releases.publish(req.params.id, req.user.uid))));
+  return router;
+}
+module.exports = createWebsiteRouter();
+module.exports.createWebsiteRouter = createWebsiteRouter;
