+// Ejecutar desde server/ con credenciales Admin del mismo proyecto que la app.
+require('../firebaseAdmin');
+const { getAuth } = require('firebase-admin/auth');
+async function main() {
+  const [email, action = 'grant'] = process.argv.slice(2);
+  if (!email || !['grant', 'revoke'].includes(action)) throw new Error('Uso: node scripts/setWebsiteAdmin.js correo@example.com grant|revoke');
+  const auth = getAuth();
+  const user = await auth.getUserByEmail(email);
+  if (!user.emailVerified || user.disabled) throw new Error('La cuenta debe tener correo verificado y estar habilitada.');
+  const claims = { ...user.customClaims };
+  if (action === 'grant') claims.milpagrowAdmin = true;
+  else delete claims.milpagrowAdmin;
+  await auth.setCustomUserClaims(user.uid, claims);
+  console.log(`Permiso administrativo ${action === 'grant' ? 'asignado' : 'retirado'} a ${email}. Inicia una nueva sesión en el panel.`);
+}
+main().catch(error => { console.error(error.message); process.exitCode = 1; });
