# Variables privadas exclusivamente del servicio Node de MilpaWeb.
# Usa el mismo proyecto y credenciales de Firebase/Brevo que MilpaGrow.
PORT=3001
FIREBASE_PROJECT_ID=nereon-milpagrow
MILPAGROW_FIREBASE_PROJECT_ID=nereon-milpagrow
GOOGLE_APPLICATION_CREDENTIALS=/ruta/privada/serviceKey.json
# En Render usa FIREBASE_SERVICE_ACCOUNT_JSON o FIREBASE_SERVICE_ACCOUNT_BASE64.
# FIREBASE_SERVICE_ACCOUNT_JSON={...contenido privado del service account...}
BREVO_API_KEY=TU_CLAVE_PRIVADA_BREVO
BREVO_FROM_EMAIL=tu-remitente-verificado@example.com
BREVO_FROM_NAME=MilpaGrow
WEBSITE_REGISTRATION_SECRET=GENERA_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
WEBSITE_ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
# En Render: WEBSITE_ALLOWED_ORIGINS=https://milpagrow-web.onrender.com
TRUST_PROXY_HOPS=0
# APK fuera de la web estática. Configura UNA de estas dos fuentes privadas.
WEBSITE_APK_PATH=
# En Render puede ser el endpoint de un asset de un repositorio privado:
# https://api.github.com/repos/OWNER/PRIVATE_REPO/releases/assets/ASSET_ID
WEBSITE_APK_URL=
# Token de lectura del origen privado. Nunca va en config.js ni en la web.
WEBSITE_APK_AUTH_TOKEN=
WEBSITE_APK_VERSION=1.0.0
